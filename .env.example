# Names only. Real values go in Vercel → Project → Settings → Environment
# Variables, never in git. Nothing here is shared with SoleTasker.

# --- Browser (safe to be public; row-level security protects the data) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SECURITY_HASH_SECRET=          # any long random string; used to hash rate-limit keys
APP_URL=                       # e.g. https://watchdog.app (production address)

OPENAI_API_KEY=                # invoice reading
INVOICE_READ_ENABLED=          # set to false to switch reading off instantly
INVOICE_READ_MONTHLY_ALLOWANCE= # default 300 reads per account per month

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
